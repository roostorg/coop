{
  "name": "@roostorg/coop-types",
  "type": "module",
  "version": "3.0.0",
  "description": "Shared TypeScript types for Coop: schema primitives, signal data maps, and integration contracts.",
  "module": "build/index.js",
  "typings": "./build/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run build && node --test 'build/test_scripts/**/*.test.js'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/roostorg/coop",
    "directory": "types"
  },
  "author": "Roostorg",
  "files": [
    "build"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "date-fns": "^2.29.3",
    "type-fest": "^4.3.2"
  }
