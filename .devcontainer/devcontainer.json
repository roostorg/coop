{
  "name": "Coop demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "COMPOSE_PROJECT_NAME": "coop",
    "COMPOSE_FILE": "${containerWorkspaceFolder}/docker-compose.images.yaml:${containerWorkspaceFolder}/.devcontainer/docker-compose.codespaces.yaml",
    "COOP_DEMO_EMAIL": "demo@coop.local",
    "COOP_DEMO_PASSWORD": "coop-demo"
  },
  "updateContentCommand": "bash .devcontainer/scripts/prepare.sh",
  "postStartCommand": "bash .devcontainer/scripts/start.sh",
  "postAttachCommand": "bash .devcontainer/scripts/status.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Coop UI",
      "onAutoForward": "openBrowserOnce"
    },
    "8080": { "label": "Coop API", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "silent" },
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/development/codespaces.md"]
    },
    "vscode": {
      "settings": {
        "workbench.startupEditor": "none",
        "workbench.editorAssociations": {
          "*.md": "vscode.markdown.preview.editor"
        }
      }
    }
  }
}
