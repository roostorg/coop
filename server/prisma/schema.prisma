  org_id                                             String                @id @db.VarChar(255)
  username                                           String                @db.VarChar(255)
  password                                           String                @db.VarChar(255)
  contact_email                                      String?               @db.VarChar(255)
  more_info_url                                      String?               @db.VarChar(255)
  company_template                                   String?               @db.VarChar(255)
  legal_url                                          String?               @db.VarChar(255)
  created_at                                         DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime              @default(now()) @db.Timestamptz(6)
  ncmec_preservation_endpoint                        String?               @db.VarChar(255)
  ncmec_additional_info_endpoint                     String?               @db.VarChar(255)
  policies_applied_to_actions_run_on_report_creation String[]              @db.VarChar(255)
  actions_to_run_upon_report_creation                String[]              @db.VarChar(255)
  default_ncmec_queue_id                             String?               @db.VarChar(255)
  default_internet_detail_type                       String?               @db.VarChar(50)
  terms_of_service                                   String?
  contact_person_email                               String?               @db.VarChar(255)
  contact_person_first_name                          String?               @db.VarChar(255)
  contact_person_last_name                           String?               @db.VarChar(255)
  contact_person_phone                               String?               @db.VarChar(50)
  media_review_requirement                           String                @default("ALL") @db.VarChar(16)
  min_media_to_review                                Int?
