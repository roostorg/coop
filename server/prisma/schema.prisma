  actions_and_item_types       actions_and_item_types[]
  rules_and_actions            rules_and_actions[]

  @@unique([org_id, name])
  @@unique([org_id, action_type], map: "actions_unique_enqueue_to_mrt_action_type", where: raw("(action_type = 'ENQUEUE_TO_MRT'::action_type)"))
  @@schema("public")
}

