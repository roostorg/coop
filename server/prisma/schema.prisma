// Materialized views. `prisma db pull` does not introspect these, so they are
// declared by hand; Prisma never creates, alters or refreshes them.

view appeals_routing_rule_versions {
  id                   String                       @db.VarChar(255)
  name                 String?                      @db.VarChar(255)
  org_id               String?                      @db.VarChar(255)
  description          String?                      @db.VarChar(255)
  status               appeals_routing_rule_status?
  creator_id           String?                      @db.VarChar(255)
  condition_set        Json?
  sequence_number      Int?
  destination_queue_id String?                      @db.VarChar(255)
  version              DateTime                     @db.Timestamptz(6)
  is_current           Boolean?

  @@unique([id, version])
  @@schema("manual_review_tool")
}

view routing_rule_versions {
  id                   String               @db.VarChar(255)
  name                 String?              @db.VarChar(255)
  org_id               String?              @db.VarChar(255)
  description          String?              @db.VarChar(255)
  status               routing_rule_status?
  creator_id           String?              @db.VarChar(255)
  condition_set        Json?
  sequence_number      Int?
  destination_queue_id String?              @db.VarChar(255)
  version              DateTime             @db.Timestamptz(6)
  is_current           Boolean?

  @@unique([id, version])
  @@schema("manual_review_tool")
}

