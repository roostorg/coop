generator client {
  provider        = "prisma-client"
  output          = "../prisma-generated"
  previewFeatures = ["partialIndexes", "views"]
  moduleFormat    = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["jobs", "manual_review_tool", "models_service", "ncmec_reporting", "public", "reporting_rules", "signal_auth_service", "signals_service", "user_management_service", "user_statistics_service"]
}

model scheduled_jobs_info {
  job_name String   @id @db.VarChar(255)
  last_run DateTime @db.Timestamptz(6)

  @@schema("jobs")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model appeals_routing_rule_history {
  id                   String                      @db.VarChar(255)
  org_id               String                      @db.VarChar(255)
  name                 String                      @db.VarChar(255)
  description          String?                     @db.VarChar(255)
  status               appeals_routing_rule_status
  creator_id           String                      @db.VarChar(255)
  condition_set        Json
  sequence_number      Int
  destination_queue_id String                      @db.VarChar(255)
  sys_period           Unsupported("tstzrange")

  @@ignore
  @@schema("manual_review_tool")
}

model appeals_routing_rules {
  id                                  String                                @id @db.VarChar(255)
  org_id                              String                                @db.VarChar(255)
  name                                String                                @db.VarChar(255)
  description                         String?                               @db.VarChar(255)
  status                              appeals_routing_rule_status           @default(LIVE)
  created_at                          DateTime                              @default(now()) @db.Timestamptz(6)
  creator_id                          String                                @db.VarChar(255)
  condition_set                       Json
  sequence_number                     Int
  destination_queue_id                String                                @db.VarChar(255)
  sys_period                          Unsupported("tstzrange")              @default(dbgenerated("tstzrange(CURRENT_TIMESTAMP, NULL::timestamp with time zone)"))
  manual_review_queues                manual_review_queues                  @relation(fields: [destination_queue_id], references: [id], onUpdate: NoAction)
  appeals_routing_rules_to_item_types appeals_routing_rules_to_item_types[]

  @@unique([org_id, name])
  @@unique([org_id, sequence_number])
  @@schema("manual_review_tool")
}

model appeals_routing_rules_to_item_types {
  item_type_id            String                @db.VarChar(255)
  appeals_routing_rule_id String                @db.VarChar(255)
  appeals_routing_rules   appeals_routing_rules @relation(fields: [appeals_routing_rule_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "appeals_routing_rules_to_item_type_appeals_routing_rule_id_fkey")

  @@id([item_type_id, appeals_routing_rule_id])
  @@schema("manual_review_tool")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model dim_mrt_decisions_materialized {
  org_id       String?   @db.VarChar(255)
  item_id      String?
  action_id    String?
  policy_id    String?
  type         String?
  item_type_id String?
  queue_id     String?   @db.VarChar(255)
  reviewer_id  String?   @db.VarChar(255)
  ds           DateTime? @db.Date
  job_id       String?
  decided_at   DateTime? @db.Timestamptz(6)

  @@index([decided_at], map: "manual_decisions_view_dec_at_idx")
  @@ignore
  @@schema("manual_review_tool")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model job_claims {
  org_id               String               @db.VarChar(255)
  queue_id             String               @db.VarChar(255)
  user_id              String               @db.VarChar(255)
  job_id               String
  claimed_at           DateTime             @default(now()) @db.Timestamptz(6)
  manual_review_queues manual_review_queues @relation(fields: [queue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([org_id, claimed_at], map: "idx_job_claims_org_claimed_at")
  @@index([org_id, job_id, claimed_at(sort: Desc)], map: "idx_job_claims_org_job_claimed_at")
  @@index([org_id, job_id, user_id, claimed_at(sort: Desc)], map: "idx_job_claims_org_job_user_claimed_at")
  @@ignore
  @@schema("manual_review_tool")
}

model job_comments {
  id           String   @id @db.VarChar(255)
  job_id       String
  org_id       String   @db.VarChar(255)
  author_id    String   @db.VarChar(255)
  comment_text String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@schema("manual_review_tool")
}

model job_creations {
  id                  String   @id
  org_id              String   @db.VarChar(255)
  queue_id            String   @db.VarChar(255)
  item_id             String
  item_type_id        String
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  enqueue_source_info Json
  policy_ids          String[] @default([])

  @@index([created_at], map: "jobs_created_at_brin_idx", type: Brin)
  @@schema("manual_review_tool")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model job_priority_weights {
  org_id     String   @db.VarChar(255)
  property   String   @db.VarChar(64)
  weight     Decimal  @default(1) @db.Decimal
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  orgs       orgs     @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([org_id, property])
  @@schema("manual_review_tool")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model manual_review_decisions {
  id                  String    @id @db.Uuid
  job_payload         Json
  queue_id            String    @db.VarChar(255)
  reviewer_id         String    @db.VarChar(255)
  org_id              String    @db.VarChar(255)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  decision_components Json[]
  related_actions     Json[]    @default([])
  enqueue_source_info Json?
  item_created_at     DateTime? @db.Timestamptz(6)
  decision_reason     String?
  assigned_at         DateTime? @db.Timestamptz(6)

  @@index([org_id, created_at], map: "idx_manual_review_decisions_org_created_assigned", where: raw("(assigned_at IS NOT NULL)"))
  @@index([org_id, created_at(sort: Desc), id(sort: Desc)], map: "idx_mrt_decisions_org_created_id")
  @@index([created_at])
  @@index([org_id], map: "mrt_decisions_org_id_idx")
  @@schema("manual_review_tool")
}

model manual_review_hidden_item_fields {
  org_id        String   @db.VarChar(255)
  item_type_id  String   @db.VarChar(255)
  hidden_fields String[] @default([])

  @@id([org_id, item_type_id])
  @@schema("manual_review_tool")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model manual_review_queues {
  id                                       String                                     @id @db.VarChar(255)
  name                                     String                                     @db.VarChar(255)
  created_at                               DateTime                                   @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime                                   @default(now()) @db.Timestamptz(6)
  org_id                                   String                                     @db.VarChar(255)
  is_default_queue                         Boolean                                    @default(false)
  description                              String?                                    @db.VarChar(255)
  is_appeals_queue                         Boolean                                    @default(false)
  auto_close_jobs                          Boolean?                                   @default(false)
  clear_reports_disposition                String?                                    @db.VarChar(64)
  clear_reports_scope                      String                                     @default("CURRENT_QUEUE") @db.VarChar(64)
  job_sort_type                            String                                     @default("FIFO") @db.VarChar(16)
  appeals_routing_rules                    appeals_routing_rules[]
  job_claims                               job_claims[]                               @ignore
  moderator_skips                          moderator_skips[]                          @ignore
  queues_and_clear_reports_trigger_actions queues_and_clear_reports_trigger_actions[]
  queues_and_hidden_actions                queues_and_hidden_actions[]
  roles_and_accessible_queues              roles_and_accessible_queues[]
  routing_rules                            routing_rules[]
  users_and_accessible_queues              users_and_accessible_queues[]
  users_and_favorite_mrt_queues            users_and_favorite_mrt_queues[]
  ncmec_org_settings                       ncmec_org_settings[]

  @@unique([org_id, is_default_queue, is_appeals_queue], map: "manual_review_queue_is_default", where: raw("(is_default_queue = true)"))
  @@unique([org_id, name, is_appeals_queue], map: "manual_review_queue_unique_name")
  @@index([org_id], map: "manual_review_decisions_org_id")
  @@index([org_id], map: "manual_review_queue_org_id")
  @@schema("manual_review_tool")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model manual_review_tool_settings {
  org_id                                 String   @id @db.VarChar(255)
  requires_policy_for_decisions          Boolean  @default(false)
  mrt_requires_decision_reason_on_action Boolean  @default(false)
  hide_skip_button_for_non_admins        Boolean? @default(false)
  ignore_callback_url                    String?  @db.VarChar(255)
  preview_jobs_view_enabled              Boolean  @default(false)
  mrt_requires_decision_reason_on_ignore Boolean  @default(false)

  @@schema("manual_review_tool")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model moderator_skips {
  org_id               String               @db.VarChar(255)
  queue_id             String               @db.VarChar(255)
  user_id              String               @db.VarChar(255)
  job_id               String
  ts                   DateTime             @default(now()) @db.Timestamptz(6)
  manual_review_queues manual_review_queues @relation(fields: [queue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@ignore
  @@schema("manual_review_tool")
}

model queues_and_clear_reports_trigger_actions {
  queue_id             String               @db.VarChar(255)
  action_id            String               @db.VarChar(255)
  org_id               String               @db.VarChar(255)
  manual_review_queues manual_review_queues @relation(fields: [queue_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "queues_and_clear_reports_trigger_actions_queue_fkey")

  @@id([queue_id, action_id])
  @@index([org_id], map: "idx_queues_and_clear_reports_trigger_actions_org_id")
  @@schema("manual_review_tool")
}

model queues_and_hidden_actions {
  queue_id             String               @db.VarChar(255)
  action_id            String               @db.VarChar(255)
  org_id               String               @db.VarChar(255)
  manual_review_queues manual_review_queues @relation(fields: [queue_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "queue_fkey")

  @@id([queue_id, action_id], map: "queues_and_actions_pkey")
  @@schema("manual_review_tool")
}

model roles_and_accessible_queues {
  queue_id             String               @db.VarChar(255)
  role_id              String               @db.Uuid
  manual_review_queues manual_review_queues @relation(fields: [queue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles                roles                @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([queue_id, role_id])
  @@index([role_id])
  @@schema("manual_review_tool")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model routing_rule_history {
  id                   String                   @db.VarChar(255)
  org_id               String                   @db.VarChar(255)
  name                 String                   @db.VarChar(255)
  description          String?                  @db.VarChar(255)
  status               routing_rule_status
  creator_id           String                   @db.VarChar(255)
  condition_set        Json
  sequence_number      Int
  destination_queue_id String                   @db.VarChar(255)
