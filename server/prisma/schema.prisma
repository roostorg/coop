  @@schema("ncmec_reporting")
}

model SequelizeMeta {
  name      String   @id @db.VarChar(255)
  createdAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model actions {
  id                           String                   @id @db.VarChar(255)
  name                         String                   @db.VarChar(255)
  description                  String?                  @db.VarChar(255)
  callback_url                 String?                  @db.VarChar(255)
  created_at                   DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                 @default(now()) @db.Timestamptz(6)
  org_id                       String                   @db.VarChar(255)
  callback_url_headers         Json?
  callback_url_body            Json?
  penalty                      user_penalty_severity    @default(NONE)
  sys_period                   Unsupported("tstzrange") @default(dbgenerated("tstzrange(CURRENT_TIMESTAMP, NULL::timestamp with time zone)"))
  action_type                  action_type              @default(CUSTOM_ACTION)
  applies_to_all_items_of_kind item_type_kind[]         @default([])
