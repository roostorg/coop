model routing_rules_to_item_types {
  item_type_id    String        @db.VarChar(255)
  routing_rule_id String        @db.VarChar(255)
  routing_rules   routing_rules @relation(fields: [routing_rule_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([item_type_id, routing_rule_id])
  @@schema("manual_review_tool")
}

model users_and_accessible_queues {
  user_id              String               @db.VarChar(255)
  queue_id             String               @db.VarChar(255)
  manual_review_queues manual_review_queues @relation(fields: [queue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, queue_id], map: "user_to_accessible_queues_pkey")
  @@schema("manual_review_tool")
}

model users_and_favorite_mrt_queues {
  user_id              String               @db.VarChar(255)
  queue_id             String               @db.VarChar(255)
  org_id               String               @db.VarChar(255)
  manual_review_queues manual_review_queues @relation(fields: [queue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, queue_id])
  @@index([user_id], map: "user_favorite_mrt_queues_idx")
  @@schema("manual_review_tool")
}

model models {
