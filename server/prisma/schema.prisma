model api_keys {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id       String    @db.VarChar(255)
  key_hash     String    @unique @db.VarChar(255)
  name         String    @db.VarChar(255)
  description  String?
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  created_by   String?   @db.VarChar(255)
  users        users?    @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  orgs         orgs      @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([org_id, is_active], map: "idx_api_keys_active", where: raw("(is_active = true)"))
  @@index([key_hash], map: "idx_api_keys_key_hash")
  @@index([org_id], map: "idx_api_keys_org_id")
  @@schema("public")
}

model backtests {
  id                      String          @id @db.VarChar(255)
  rule_id                 String          @db.VarChar(255)
  creator_id              String          @db.VarChar(255)
  sample_desired_size     Int
  sample_actual_size      Int             @default(0)
  sample_start_at         DateTime        @db.Timestamptz(6)
  sample_end_at           DateTime        @db.Timestamptz(6)
  sampling_complete       Boolean         @default(false)
  content_items_processed Int             @default(0)
  content_items_matched   Int             @default(0)
  created_at              DateTime        @default(now()) @db.Timestamptz(6)
  updated_at              DateTime        @db.Timestamptz(6)
  cancelation_date        DateTime?       @db.Timestamptz(6)
  status                  backtest_status @default(dbgenerated("\nCASE\n    WHEN (cancelation_date IS NOT NULL) THEN 'CANCELED'::backtest_status\n    WHEN ((sampling_complete = false) OR (content_items_processed < sample_actual_size)) THEN 'RUNNING'::backtest_status\n    ELSE 'COMPLETE'::backtest_status\nEND"))
  users                   users           @relation(fields: [creator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rules                   rules           @relation(fields: [rule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

